<!DOCTYPE html>
<html lang="en">
<head>
  <title>TTdb | <%= (yield(:title).empty? ? "Tango Translation Database" : yield(:title)) %></title>
  <meta name="description" content="Tango Translation Database links Argentine Tango song translations from Spanish to many languages">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= favicon_link_tag "favicon.ico" %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/v4-shims.min.css" crossorigin="anonymous">
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" defer></script>
  <%= javascript_importmap_tags %>
</head>
<body>
  <%= render 'layouts/header' %>
  <div class="container-fluid">
    <div class="row">
      <div id="content" class="col-12 col-sm-8 col-md-9">

        <div id="search_link" class="d-block d-sm-none">
          <%= link_to "Scroll to Search", "#search_anchor", class: 'btn btn-lg btn-info' %>
        </div>

        <%= render partial: 'shared/flash', locals: { f: flash } %>

        <div class="page-header">
          <% if controller?('songs', 'translations') %>
            <h4 class="float-end"><%= yield(:display_count) %></h4>
          <% end %>
          <h1><%= yield(:title) %></h1>
        </div>

        <%= yield %>

        <p class="spacer">&nbsp;</p>
      </div>
      <div id="sidebar" class="col-12 col-sm-4 col-md-3">
        <div id="search">
          <%= render 'layouts/search' %>
        </div>
        <div id="stats">
          <%= render 'layouts/stats' %>
        </div>
      </div>
      <p class="spacer">&nbsp;</p>
    </div>
  </div>
  <%= render 'layouts/footer' %>
</body>
</html>
