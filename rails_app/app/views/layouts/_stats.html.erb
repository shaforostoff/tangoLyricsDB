<% last_song = Song.unscoped.last %>
<% last_translation_song = Translation.unscoped.includes(:song).last&.song %>
<h4><%= Song.count %> songs</h4>
<h4><%= Translation.count %> translations</h4>
<h4>last Song: <%= last_song ? link_to(last_song.title, last_song) : "N/A" %></h4>
<h4>last Translation: <%= last_translation_song ? link_to(last_translation_song.title, last_translation_song) : "N/A" %></h4>
