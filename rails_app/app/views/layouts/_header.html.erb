<nav id="header" class="navbar navbar-expand-md navbar-dark fixed-top">
  <div class="container-fluid">
    <%= link_to image_tag('logo.webp', height: 40, width: 40, alt: "TTdb"), root_path, class: "navbar-brand py-0" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#TTD_main_navbar" aria-controls="TTD_main_navbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="TTD_main_navbar">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><%= link_to "Songs", songs_path, class: "nav-link #{'active' if controller?('songs')}" %></li>
        <li class="nav-item"><%= link_to "Translators", translators_path, class: "nav-link #{'active' if controller?('translators')}" %></li>
        <li class="nav-item"><%= link_to "Languages", languages_path, class: "nav-link #{'active' if controller?('languages')}" %></li>
        <li class="nav-item"><%= link_to "Genres", genres_path, class: "nav-link #{'active' if controller?('genres')}" %></li>
        <li class="nav-item dropdown">
          <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">Info</a>
          <ul class="dropdown-menu">
            <li><%= link_to "About", about_path, class: "dropdown-item #{'active' if current_page?(about_path)}" %></li>
            <li><%= link_to "Usage", usage_path, class: "dropdown-item #{'active' if current_page?(usage_path)}" %></li>
            <li><%= link_to "Stats", stats_path, class: "dropdown-item #{'active' if current_page?(stats_path)}" %></li>
            <li><%= link_to "Admin", inactive_translations_path, class: "dropdown-item #{'active' if current_page?(inactive_translations_path)}" %></li>
          </ul>
        </li>
      </ul>
      <ul class="navbar-nav">
        <% if user_signed_in? %>
          <li class="nav-item"><span class="navbar-text me-2">User: <%= current_user.email %></span></li>
          <li class="nav-item"><%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %></li>
        <% else %>
          <li class="nav-item"><%= link_to "Sign In", new_user_session_path, class: "nav-link" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
