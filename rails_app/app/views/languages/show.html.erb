<%- model_class = Language -%>
<% title @language.name %>

<dl class="row">
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:name) %>:</strong></dt>
  <dd class="col-sm-9"><%= @language.name %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= "ISO" %>:</strong></dt>
  <dd class="col-sm-9"><%= @language.iso %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:count) %>:</strong></dt>
  <dd class="col-sm-9"><%= @language.translations_count %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:search) %>:</strong></dt>
  <dd class="col-sm-9"><%= render partial: 'shared/search_icon', locals: { f: @language } %></dd>
</dl>

<div class="form-actions">
  <%= link_to '<i class="fa fa-chevron-left"></i> '.html_safe + t('.back', :default => t("helpers.links.back")),
              languages_path, :class => 'btn btn-outline-secondary'  %>
  <%= link_to '<i class="fa fa-edit"></i> '.html_safe + t('.edit', :default => t("helpers.links.edit")),
              edit_language_path(@language), :class => 'btn btn-warning' %>
  <%= link_to '<i class="fa fa-trash"></i> '.html_safe + t('.destroy', :default => t("helpers.links.destroy")),
              language_path(@language),
              data: { turbo_method: :delete, turbo_confirm: t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
</div>
