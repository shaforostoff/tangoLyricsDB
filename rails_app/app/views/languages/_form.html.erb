<%= form_for @language, :html => {} do |f| %>

	<%= render partial: 'shared/error', locals: {f: @language} %>
	
  <div class="row mb-3">
    <%= f.label :name, class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= f.text_field :name, class: 'form-control' %>
    </div>
  </div>
	
	<div class="row mb-3">
    <%= f.label :iso, "ISO", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= f.text_field :iso, class: 'form-control' %>
    </div>
  </div>

	<div class="row mb-3">
		<div class="col-sm-10 offset-sm-2">
    <%= f.submit nil, class: 'btn btn-primary' %>
    <%= link_to '<i class="fa fa-trash"></i> '.html_safe + t('.cancel', :default => t("helpers.links.cancel")),
                languages_path, class: 'btn btn-outline-secondary' %>
		</div>
  </div>
<% end %>
