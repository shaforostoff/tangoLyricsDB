<% title "Sign in" %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'form-horizontal' }) do |f| %>

  <div class="row mb-3">
		<%= f.label :email, class: 'col-sm-2 col-form-label' %>
		<div class="col-sm-10">
  		<%= f.email_field :email, autofocus: true, class: 'form-control' %>
		</div>
	</div>

  <div class="row mb-3">
		<%= f.label :password, class: 'col-sm-2 col-form-label' %>
		<div class="col-sm-10">
    	<%= f.password_field :password, autocomplete: "off", class: 'form-control' %>
		</div>
	</div>

  <% if devise_mapping.rememberable? -%>
    <div class="row mb-3">
			<div class="col-sm-10 offset-sm-2">
				<div class="form-check"><%= f.check_box :remember_me, class: 'form-check-input' %> <%= f.label :remember_me, class: 'form-check-label' %></div>
			</div>
		</div>
  <% end -%>

  <div class="row mb-3">
		<div class="col-sm-10 offset-sm-2">
			<%= f.submit "Sign in", class: 'btn btn-primary' %>
		</div>
	</div>
	
	<%= render "devise/shared/links" %>
<% end %>
