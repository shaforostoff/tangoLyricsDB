<% f.each do |name, msg| %>
  <%= content_tag :div, class: "alert alert-#{ name == 'error' || name == 'alert' ? 'danger' : 'success' } alert-dismissible fade show", role: "alert" do %>
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  <% end %>
<% end %>
