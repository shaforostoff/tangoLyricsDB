<%= form_for @song, :html => {} do |f| %>
	
	<%= render partial: 'shared/error', locals: {f: @song} %>
		
	<div class="row mb-3">
		<%= f.label :title, class: 'col-sm-2 col-form-label' %>
		<div class="col-sm-10">
			<%= f.text_field :title, class: 'form-control' %>
		</div>
	</div>
	<div class="row mb-3">
		<%= f.label :genre, class: 'col-sm-2 col-form-label' %>
		<div class="col-sm-10">
			<%= f.collection_select :genre_id, Genre.all, :id, :name, {prompt: true}, {class: 'form-select'} %>
		</div>
	</div>
	<div class="row mb-3">
		<%= f.label :composer, class: 'col-sm-2 col-form-label' %>
		<div class="col-sm-10">
			<%= f.text_field :composer, class: 'form-control' %>
		</div>
	</div>
	<div class="row mb-3">
		<%= f.label :lyricist, class: 'col-sm-2 col-form-label' %>
		<div class="col-sm-10">
			<%= f.text_field :lyricist, class: 'form-control' %>
		</div>
	</div>
	<div class="row mb-3">
		<%= f.label :year, class: 'col-sm-2 col-form-label' %>
		<div class="col-sm-10">
			<%= f.text_field :year, class: 'form-control' %>
		</div>
	</div>

	<div class="row mb-3">
		<div class="col-sm-10 offset-sm-2">
			<%= f.submit nil, class: 'btn btn-primary' %>
			<%= link_to '<i class="fa fa-trash"></i> '.html_safe + t('.cancel', :default => t("helpers.links.cancel")),
				songs_path, class: 'btn btn-outline-secondary' %>
		</div>
	</div>
<% end %>

