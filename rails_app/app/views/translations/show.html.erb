<%- model_class = Translation -%>
<% title @translation.song.title %>

<dl class="row">
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:song) %>:</strong></dt>
  <dd class="col-sm-9"><%= link_to @translation.song.title, @translation.song %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:link) %>:</strong></dt>
  <dd class="col-sm-9"><%= link_to URI.decode_www_form_component(@translation.link), @translation.link, :target => "_blank" %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:language) %>:</strong></dt>
  <dd class="col-sm-9"><%= @translation.language.name %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:active?) %>:</strong></dt>
  <dd class="col-sm-9"><%= render partial: 'translations/active_icon', object: @translation, as: 'translation' %></dd>
</dl>

<div class="form-actions">
  <%= link_to '<i class="fa fa-chevron-left"></i> '.html_safe + t('.back', :default => t("helpers.links.back")),
              song_path(@translation.song), :class => 'btn btn-outline-secondary'  %>
  <%= link_to '<i class="fa fa-edit"></i> '.html_safe + t('.edit', :default => t("helpers.links.edit")),
              edit_song_translation_path(@translation.song, @translation), :class => 'btn btn-warning' %>
  <%= link_to '<i class="fa fa-trash"></i> '.html_safe + t('.destroy', :default => t("helpers.links.destroy")),
              [@translation.song, @translation],
              data: { turbo_method: :delete, turbo_confirm: t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
</div>