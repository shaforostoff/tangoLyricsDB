<tr>
  <td><%= render partial: 'translations/active_icon', object: translation, as: 'translation' %></td>
	<td class='search_column'><%= link_to raw("<i class='fa fa-link'></i>"), translation.link.gsub(/youtube.com.*watch/,"youtube.com/watch").gsub(/tangowiki.org.*Lyrics:/,"tangowiki.org/wiki/"), :class => 'btn btn-sm btn-primary', 'data-bs-toggle' => 'tooltip', 'data-bs-placement' => 'right', title: URI::RFC2396_PARSER.unescape(translation.link.gsub(/youtube.com.*watch/,"youtube.com/watch").gsub(/tangowiki.org.*Lyrics:/,"tangowiki.org/wiki/")), rel: :tooltip, :target => "_blank" %></td>
	
	<% if controller?('translations') %>
	<td><%= link_to translation.song.title, song_path(translation.song) %></td>
	<% end %>
	
	<td><%= translation.translator_id == 0 ? "[Not categorised]" : ( translation.translator ? link_to(translation.translator.site_name, translator_path(translation.translator) ) : "[Error]" ) %></td>
	<td class='search_column'><%= translation.language ? link_to(translation.language.iso, language_path(translation.language) ) : "[Error]" %></td>
	
	<td class='action_column'>
    <%= link_to raw('<i class="fa fa-eye"></i>'),
                song_translation_path(translation.song, translation),  :class => 'btn btn-sm btn-outline-secondary' %>
    <%= link_to raw('<i class="fa fa-edit"></i>'),
                edit_song_translation_path(translation.song, translation),  :class => 'btn btn-sm btn-warning' %>
		<%= link_to raw('<i class="fa fa-trash"></i>'),
												[translation.song, translation],
					              data: { turbo_method: :delete, turbo_confirm: t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
												:class => 'btn btn-sm btn-danger' %>
	</td>
</tr>
