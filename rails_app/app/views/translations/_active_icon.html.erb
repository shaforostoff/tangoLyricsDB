<%= link_to raw(translation.active ? '<i type="button" class="fa fa-check"></i>' : '<i type="button" class="fa fa-exclamation-circle"></i>'),
	check_link_song_translation_path(translation.song, translation),
	data: { turbo_method: :put },
	:class => translation.active.nil? ? 'btn btn-sm btn-warning btn-circle' : translation.active ? 'btn btn-sm btn-success btn-circle' : 'btn btn-sm btn-danger btn-circle' %>
