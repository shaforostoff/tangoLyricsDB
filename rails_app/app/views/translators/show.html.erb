<%- model_class = Translator -%>
<% title @translator.site_name %>

<dl class="row">
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:site_name) %>:</strong></dt>
  <dd class="col-sm-9"><%= @translator.site_name %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:site_link) %>:</strong></dt>
  <dd class="col-sm-9"><%= link_to @translator.site_link, @translator.site_link, :target => "_blank" %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:translator) %>:</strong></dt>
  <dd class="col-sm-9"><%= @translator.name %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:count) %>:</strong></dt>
  <dd class="col-sm-9"><%= @translator.translations.size %></dd>
  <dt class="col-sm-3 text-sm-end"><strong><%= model_class.human_attribute_name(:search) %>:</strong></dt>
  <dd class="col-sm-9"><%= render partial: 'shared/search_icon', locals: { f: @translator } %></dd>
</dl>

<div class="form-actions">
  <%= link_to '<i class="fa fa-chevron-left"></i> '.html_safe + t('.back', :default => t("helpers.links.back")),
              translators_path, :class => 'btn btn-outline-secondary'  %>
  <%= link_to '<i class="fa fa-edit"></i> '.html_safe + t('.edit', :default => t("helpers.links.edit")),
              edit_translator_path(@translator), :class => 'btn btn-warning' %>
  <%= link_to '<i class="fa fa-trash"></i> '.html_safe + t('.destroy', :default => t("helpers.links.destroy")),
              translator_path(@translator),
              data: { turbo_method: :delete, turbo_confirm: t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
</div>
