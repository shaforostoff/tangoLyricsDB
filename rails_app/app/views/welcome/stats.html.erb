<% title "Stats" %>

<%= column_chart Song.unscoped.order("year").group(:year).count, xtitle: 'Year', ytitle: 'Number of songs' %>

<%= column_chart Language.unscoped.order("name").joins(:translations).group("name").count, xtitle: 'Language', ytitle: 'Number of translations' %>

<%= column_chart Genre.unscoped.order("name").joins(:songs).group("name").count, xtitle: 'Genre', ytitle: 'Number of songs' %>

<%= column_chart Song.unscoped.group(:translations_count).count, xtitle: 'Number of translations', ytitle: 'Number of songs' %>
